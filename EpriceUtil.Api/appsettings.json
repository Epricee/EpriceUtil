{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Async",
      "Serilog.Sinks.Graylog"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Graylog",
              "Args": {
                "hostnameOrAddress": "10.0.0.4",
                "port": 12201,
                "transportType": "Udp"
              }
            }
          ],
          "bufferSize": 10000,
          "blockWhenFull": false
        }
      }
    ],
    "Properties": {
      "Application": "EpriceUtil",
      "Source": "EpriceUtil"
    }
  },
  "UtilToken": "eYKMiZk93qYAN4QSfx0duut5pQh9wCkpPJUVwlNviudW03zYI1l5DZ7rA5XsTOYP",
  "U2NetUrl": "http://storages3.eprice.com.br/utils/u2net.onnx",
  "JobGateLimit": 1,
  "UtilVersion": "1.0.0.0"
}
